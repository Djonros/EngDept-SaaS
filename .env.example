#
#  Copy this file to .env.local and fill in your values.
#  Command: copy .env.example .env.local
#

# ---- Supabase (required) ----
# Get these from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ---- Telegram Bot (optional) ----
# Get token from: @BotFather in Telegram
TELEGRAM_BOT_TOKEN=
# Secret token for webhook verification (generate any random string)
TELEGRAM_WEBHOOK_SECRET=
# Set this to your domain for webhook mode in production
TELEGRAM_WEBHOOK_URL=

# ---- Site URL (optional, default: http://localhost:3000) ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- License Encryption (optional, for hardware fingerprint) ----
# Must be at least 32 characters. Change in production!
LICENSE_ENCRYPTION_KEY=default-dev-key-change-me-32!
